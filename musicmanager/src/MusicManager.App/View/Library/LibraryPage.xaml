<Page
    x:Class="MusicManager.App.View.Library.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicManager.App.View.Library"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Ctrl+F from anywhere on the page puts the cursor in the search box -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <!-- the page itself is transparent so that Mica shows through; the content column stops growing on wide windows -->
    <Grid Padding="{StaticResource PagePadding}">
        <Grid MaxWidth="{StaticResource PageContentMaxWidth}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- the folder, how many songs and how many are selected, and the search -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="FolderLabel"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                    <TextBlock
                        x:Name="CountLabel"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Width="300"
                    VerticalAlignment="Center"
                    PlaceholderText="Search songs"
                    QueryIcon="Find"
                    AutomationProperties.Name="Search songs"
                    TextChanged="SearchBox_TextChanged"
                    KeyDown="SearchBox_KeyDown" />
            </Grid>

            <!-- the filter chips with their counts, and Select all / Select none -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <SelectorBar
                        x:Name="ChipBar"
                        HorizontalAlignment="Left"
                        SelectionChanged="ChipBar_SelectionChanged" />
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAllButton_Click" />
                    <Button x:Name="SelectNoneButton" Content="Select none" Click="SelectNoneButton_Click" />
                </StackPanel>
            </Grid>

            <!--
              the thin bar while the folder is read or the lyrics are checked (it fills when the count is known), then what
              went wrong. The bar has no words: the page only shows that it is busy
            -->
            <StackPanel Grid.Row="2" Spacing="8">
                <ProgressBar
                    x:Name="WorkProgress"
                    Visibility="Collapsed"
                    IsIndeterminate="True" />
                <InfoBar
                    x:Name="ProblemBar"
                    Severity="Error"
                    IsOpen="False"
                    IsClosable="True"
                    Closed="ProblemBar_Closed" />
            </StackPanel>

            <!--
              the song cards, or one sentence when there is nothing to show
            -->
            <Grid x:Name="CenterArea" Grid.Row="3">
                <local:SongGrid x:Name="Songs" />
                <StackPanel
                    x:Name="MessagePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="MessageLabel"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalTextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Options, what Process will do with them, and Process -->
            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="12,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OptionsButton" Click="OptionsButton_Click" AutomationProperties.Name="Options">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Options" />
                        </StackPanel>
                    </Button>

                    <!-- what Process will do with the Options -->
                    <TextBlock
                        x:Name="OptionsCaption"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />

                    <Button
                        x:Name="ProcessButton"
                        Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ProcessButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                            <TextBlock x:Name="ProcessLabel" Text="Process" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
