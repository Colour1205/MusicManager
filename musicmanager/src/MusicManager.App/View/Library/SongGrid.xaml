<UserControl
    x:Class="MusicManager.App.View.Library.SongGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicManager.App.View.Library"
    KeyDown="OnKeyDown">

    <UserControl.Resources>
        <!--
          One song card: the stock card look (card fill, 1 px card stroke, overlay corner radius), a check box, the cover,
          the title, the artists and the status line: one word (Word-synced or Line-synced) or nothing, no tool tip. It is
          the secondary text color, through two text blocks of which one shows (the other is the critical color, for a
          failed conversion), so the colors are theme resources that follow light/dark.
        -->
        <DataTemplate x:Key="SongCardTemplate" x:DataType="local:SongCardItem">
            <ItemContainer AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                Grid.Column="0"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Select this song"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                            <Grid Grid.Column="1" Width="64" Height="64">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Visibility="{x:Bind NoCoverVisibility, Mode=OneWay}">
                                    <FontIcon
                                        Glyph="&#xE8D6;"
                                        FontSize="24"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                                <Border CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                                <TextBlock
                                    Text="{x:Bind Artists}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                                <!--
                                  A song that is not checked yet shows one static muted bar here instead of a text; it
                                  exists only while the song is unchecked (x:Load). The line keeps the height of a text
                                  line, so the card does not jump when the result arrives.
                                -->
                                <Grid MinHeight="16">
                                    <Border
                                        x:Name="StatusPlaceholder"
                                        x:Load="{x:Bind IsStatusUnknown, Mode=OneWay}"
                                        Width="110"
                                        Height="10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        Visibility="{x:Bind BadVisibility, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        Visibility="{x:Bind NeutralVisibility, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- a selected card gets the accent outline on top of the card stroke -->
                    <Border
                        IsHitTestVisible="False"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </UserControl.Resources>

    <!-- the cards reflow: as many columns as fit, each at least 320 wide, all stretched to fill the row -->
    <ItemsView
        x:Name="Cards"
        ItemTemplate="{StaticResource SongCardTemplate}"
        SelectionMode="None"
        IsItemInvokedEnabled="True"
        ItemInvoked="Cards_ItemInvoked">
        <ItemsView.Layout>
            <UniformGridLayout
                MinItemWidth="320"
                MinItemHeight="90"
                MinRowSpacing="8"
                MinColumnSpacing="8"
                ItemsStretch="Fill" />
        </ItemsView.Layout>
    </ItemsView>
</UserControl>
