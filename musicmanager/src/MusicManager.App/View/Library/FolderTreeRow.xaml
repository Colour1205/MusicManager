<UserControl
    x:Class="MusicManager.App.View.Library.FolderTreeRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch">

    <!--
      One row of the folder tree of the review: a folder or a song with what happens to it under its name, or a line of text.
      The look follows the tone through the visual states, so it follows the theme: changed = the line under the name is the
      accent colour, problem = critical, gone = a folder that has no songs left is dimmed, note = secondary text with no icon.
    -->
    <Grid x:Name="Row" ColumnSpacing="10" Padding="0,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <FontIcon x:Name="FolderIcon" Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
        <FontIcon x:Name="SongIcon" Glyph="&#xE8D6;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                  Visibility="Collapsed" />

        <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="NameText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Plain" />
                <VisualState x:Name="Changed">
                    <VisualState.Setters>
                        <Setter Target="DetailText.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Problem">
                    <VisualState.Setters>
                        <Setter Target="DetailText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Gone">
                    <VisualState.Setters>
                        <Setter Target="NameText.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Setter Target="FolderIcon.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Note">
                    <VisualState.Setters>
                        <Setter Target="NameText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
