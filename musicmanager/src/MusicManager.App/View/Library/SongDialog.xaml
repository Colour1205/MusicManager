<ContentDialog
    x:Class="MusicManager.App.View.Library.SongDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicManager.App.View.Library"
    PrimaryButtonText="Process this song"
    SecondaryButtonText="Options"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- the stock dialog is 548 wide at most; the changed lines and file names need a little more -->
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>

        <!-- a file that is written ("+ .lrc  new word-synced file ...") or the old files that go ("- Deletes the old .ttml") -->
        <DataTemplate x:Key="FileRowTemplate" x:DataType="local:PreviewFileRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="+"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind WriteVisibility}" />
                <Grid
                    Grid.Column="1"
                    ColumnSpacing="8"
                    Visibility="{x:Bind WriteVisibility}"
                    ToolTipService.ToolTip="{x:Bind Name}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind Ending}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Note}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                </Grid>

                <TextBlock
                    Text="&#x2212;"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind DeleteVisibility}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Sentence}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind DeleteVisibility}" />
            </Grid>
        </DataTemplate>

        <!-- a tag: "Artist  aespa" when nothing changes, "Artist  old (struck out) -> new (accent)" when it does -->
        <DataTemplate x:Key="TagRowTemplate" x:DataType="local:PreviewTagRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind Label}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Value}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind PlainVisibility}"
                    ToolTipService.ToolTip="{x:Bind Value}" />
                <StackPanel
                    Grid.Column="1"
                    Visibility="{x:Bind ChangedVisibility}"
                    ToolTipService.ToolTip="{x:Bind ChangeToolTip}">
                    <TextBlock
                        Text="{x:Bind Before}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextDecorations="Strikethrough"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind AfterText}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">

        <!-- the song: cover, title, artists, album, path -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="80" Height="80" VerticalAlignment="Top">
                <Border
                    x:Name="CoverPlaceholder"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <FontIcon
                        Glyph="&#xE8D6;"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Border>
                <Border CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="ArtistsText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="AlbumText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    MaxLines="1" />
                <TextBlock
                    x:Name="PathText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    MaxLines="1" />
            </StackPanel>
        </Grid>

        <!-- Lyrics: the files that are written and deleted, the lines whose romaji changes -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Lyrics" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <!--
                  While the lyrics part is worked out: the status text, and under it redacted blocks that stand for the changed
                  lines. Both are collapsed as soon as the answer is there, which stops their animations.
                -->
                <local:AiStatusText x:Name="LyricsThinking" HorizontalAlignment="Left" />
                <local:SkeletonLines x:Name="LyricsSkeleton" Height="150" />

                <TextBlock
                    x:Name="LyricsMessageNeutral"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="LyricsMessageBad"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />

                <ItemsControl x:Name="FileRows" ItemTemplate="{StaticResource FileRowTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <local:ChangedLinesView x:Name="LinesView" />

                <TextBlock
                    x:Name="LyricsNotes"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Tags: the artist names -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Tags" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ItemsControl x:Name="TagRows" ItemTemplate="{StaticResource TagRowTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- while the artist names are worked out: one redacted block under the Artist row, where the new name will be -->
                <local:SkeletonLines x:Name="TagsSkeleton" OneBar="True" />

                <TextBlock
                    x:Name="TagsNote"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
