<UserControl
    x:Class="MusicManager.App.View.Library.ResultCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch">

    <!--
      One read-only card of the review (a song's lyrics result, or a song's tag changes): the title, what happens, the
      details and a status line. The status line is coloured by tone through the visual states, so it follows the theme:
      accent = something will change, secondary = fine, critical = a problem.
    -->
    <Border x:Name="Card" Style="{StaticResource CardBorderStyle}" Padding="16,12">
        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailsText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Accent">
                    <VisualState.Setters>
                        <Setter Target="StatusText.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="StatusText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Border>
</UserControl>
