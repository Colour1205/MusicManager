# ---- build output (everything dotnet build / publish / test makes) ----
[Bb]in/
[Oo]bj/
publish/
[Pp]ublish-*/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
x64/
x86/
ARM64/
*.binlog
*.pdb
*.ilk
*.exp
*.pri
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.xml
coverage*.json
lcov.info

# ---- packaging and signing (an exe is 70 MB and GitHub refuses files over 100 MB) ----
*.exe
*.msi
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
*.appxupload
AppPackages/
BundleArtifacts/
*.nupkg
*.snupkg
*.pfx
*.p12
*.snk
*.cer
*.jar
*.zip
*.7z

# ---- keys, tokens and local settings: never upload these ----
.env
.env.*
*.key
*.pem
secrets.json
appsettings.*.local.json
local.settings.json
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# ---- the app's own data (it keeps this in the user profile, but never in the repo) ----
.musicmanager/
romaji-cache.json
artist-cache.json
# a music library is the user's data, not source code: audio, lyric files and covers copied in for a test stay out
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.wav
*.wma
*.lrc
*.ttml
*.hmrc
.thumbnails/
.nomedia

# ---- editors and tools ----
.vs/
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
.claude/
.github/modernize/

# ---- leftovers of the old Java build ----
target/
dependency-reduced-pom.xml

# ---- logs, scratch files and the operating system ----
*.log
*.tmp
*.bak
*.orig
*.rej
scratch/
~$*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.DS_Store
$RECYCLE.BIN/
